import numpy as np
another_array = np.zeros((2, 4, 6))
#WRITE YOUR CODE INTO THIS CELL (add 2 comments; edit 1 line of code)
another_array = np.zeros((2, 4, 6))
new_array = another_array.copy() # .copy() creates a deep/true copy
new_array[1, 2, 2] = 1
print(another_array[1, 2, 2])
# Simply using "=" assigns a new variable to the object. Changes to new_array then also reflect in another_array. In R, "a = b" simply creates a deep copy of b named a, no specifications needed.
