# Load libraries
library(titanic)
library(ggplot2)
# Create plot of count of survivors by sex
survivors_by_sex = ggplot(data = titanic_train, aes(fill = factor(Survived), x= Sex)) +
geom_bar(stat = "count") +    # Bar plot
scale_fill_discrete(  # Legend label as in task
name = "How did it go?",
labels = c("dead", "alive")
) +
scale_x_discrete(name = "Sex") +  # Axis label as in task
scale_y_continuous(
name = "count",  # Axis label as in task
breaks = c(0, 200, 400, 600))  # Line breaks as in task
# Show the final plot
print(survivors_by_sex)
# Trying out different themes:
survivors_by_sex +
theme_dark()
survivors_by_sex +
theme_minimal()
survivors_by_sex +
theme_classic()
